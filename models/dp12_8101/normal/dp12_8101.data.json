112": {"id": 810112, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|DP12|VALENTINE", "delay": 1000, "is_hurt": 0}}, "voiceData": {"810101": {"char_code": "", "voice_key": "", "caption": ""}, "810102": {"char_code": "", "voice_key": "", "caption": ""}, "810103": {"char_code": "", "voice_key": "", "caption": ""}, "810104": {"char_code": "DP12", "voice_key": "HELLO", "caption": "As always, you showed up at work on time."}, "810105": {"char_code": "DP12", "voice_key": "DIALOGUE2", "caption": "KSVK ran off? Don't worry. She just heard about a new theory and couldn't wait to test it out. Seriously. She didn't even listen to the whole demon-summoning incantation."}, "810106": {"char_code": "DP12", "voice_key": "BREAK", "caption": "Holy... They really do pack a punch."}, "810107": {"char_code": "DP12", "voice_key": "MEET", "caption": "Here, surprise."}, "810108": {"char_code": "DP12", "voice_key": "GAIN", "caption": "DP-12, here to provide physical and mental protection. Hmm...want to hear the story behind my name, Commander?"}, "810109": {"char_code": "DP12", "voice_key": "DIALOGUEWEDDING", "caption": "I don't want to stop reading or writing here at Griffin. Even though we'll leave the world behind one day, legends are eternal... I mean, would you like to be the protagonist in my novel?"}, "810110": {"char_code": "DP12", "voice_key": "SOULCONTRACT", "caption": "Gotcha, Commander. Now where's my reward? <>...I didn't expect it to be this. I thought it'd take you longer to give it to me... Still, I'm not giving it back. <>Then let's stay together and witness how all stories end..."}, "810111": {"char_code": "", "voice_key": "", "caption": ""}, "810112": {"char_code": "DP12", "voice_key": "VALENTINE", "caption": "It seems every country has a Valentine's Day of their own, each with their own reasons and practices. But since Griffin has its own practices too, can I trouble you to accept these chocolates? ...Yes, they're mustard flavored. Hehe, I was just kidding."}}}