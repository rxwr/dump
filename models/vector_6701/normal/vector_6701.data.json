ay": 0, "is_hurt": 0}, "670112": {"id": 670112, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|Vector|HELLO", "delay": 0, "is_hurt": 0}, "670121": {"id": 670121, "motion_name": "motions/repeat.mtn", "touch_area": "0", "probability": 1.0, "voice": "", "delay": 0, "is_hurt": 0}}, "voiceData": {"670101": {"char_code": "", "voice_key": "", "caption": ""}, "670102": {"char_code": "", "voice_key": "", "caption": ""}, "670103": {"char_code": "", "voice_key": "", "caption": ""}, "670104": {"char_code": "Vector", "voice_key": "DIALOGUE1", "caption": "Advice? Will you even listen?"}, "670105": {"char_code": "Vector", "voice_key": "DIALOGUE3", "caption": "My origins, my prototype...are all meaningless. After all, I'm just a tool that follows orders..."}, "670106": {"char_code": "Vector", "voice_key": "LOADING", "caption": "Why the rush? Why not calm down a little?"}, "670107": {"char_code": "Vector", "voice_key": "DIALOGUE2", "caption": "It's okay... Don't worry about it."}, "670108": {"char_code": "Vector", "voice_key": "NEWYEAR", "caption": "I can't believe you actually managed to put up with someone like me for a year. Well done, Commander."}, "670109": {"char_code": "Vector", "voice_key": "DIALOGUEWEDDING", "caption": "How much longer can you keep up with this act? If you can't pretend any longer then say so. I don't want to believe in a lie..."}, "670110": {"char_code": "Vector", "voice_key": "SOULCONTRACT", "caption": "I'd never expected a result like this.<>Since I've always been difficult with you, I'll take it as my loss this time.<>But, don't think that it's going to end like this."}, "670111": {"char_code": "", "voice_key": "", "caption": ""}, "670112": {"char_code": "Vector", "voice_key": "HELLO", "caption": "I'm your secretary today (laughs coldly). Are you disappointed, Commander?"}, "670121": {"char_code": "", "voice_key": "", "caption": ""}}}