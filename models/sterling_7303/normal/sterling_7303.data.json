: "", "delay": 0, "is_hurt": 0}, "730312": {"id": 730312, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|Sterling|BUILDOVER", "delay": 10930, "is_hurt": 0}, "730321": {"id": 730321, "motion_name": "motions/daiji BG.mtn", "touch_area": "0", "probability": 1.0, "voice": "", "delay": 0, "is_hurt": 0}}, "voiceData": {"730301": {"char_code": "", "voice_key": "", "caption": ""}, "730302": {"char_code": "", "voice_key": "", "caption": ""}, "730303": {"char_code": "", "voice_key": "", "caption": ""}, "730304": {"char_code": "Sterling", "voice_key": "DIALOGUE2", "caption": "You couldn't find me today? I was scouting out the lair of the Army of Darkness. You were worried I got captured? Hmph, if the enemy could actually do that, I'd be cheering them on."}, "730305": {"char_code": "Sterling", "voice_key": "HELLO", "caption": "Sshhh — the miracle-coveting Army of Darkness is waiting for us."}, "730306": {"char_code": "Sterling", "voice_key": "DIALOGUE1", "caption": "So I'm just taking care of documents today? When will I get to go on the frontlines... That would be a heavenly assignment for Strling!"}, "730307": {"char_code": "Sterling", "voice_key": "LOADING", "caption": "You really are a patient one... Well, Sterling isn't going to wait around! Let me know when something good happens, I'm going to go take a walk!"}, "730308": {"char_code": "Sterling", "voice_key": "TIP", "caption": "The enemy must be very happy that Sterling is in your office. Otherwise, they'd all be dead by now!"}, "730309": {"char_code": "Sterling", "voice_key": "DIALOGUEWEDDING", "caption": "So you've seen the true face of the Army of Darkness? You didn't fight them, did you? They're too dangerous for a human like you, Commander... You saw me and Lady Matilda fight a pack of stray cats? So you already knew..."}, "730310": {"char_code": "Sterling", "voice_key": "SOULCONTRACT", "caption": "Lady Matilda, what's that you're holding in your beak... A gift from the Commander? <> So you actually wanted to go adventuring with me? And you were making such a big fuss about it at first... <> Well, at least you understand now! The future has limitless possibilities when you're with me!"}, "730311": {"char_code": "", "voice_key": "", "caption": ""}, "730312": {"char_code": "Sterling", "voice_key": "BUILDOVER", "caption": "Lady Matilda, go see what the new girl is like."}, "730321": {"char_code": "", "voice_key": "", "caption": ""}}}