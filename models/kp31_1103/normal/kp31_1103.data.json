{"id": 110312, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|KP31|HELLO", "delay": 0, "is_hurt": 0}}, "voiceData": {"110301": {"char_code": "", "voice_key": "", "caption": ""}, "110302": {"char_code": "", "voice_key": "", "caption": ""}, "110303": {"char_code": "", "voice_key": "", "caption": ""}, "110304": {"char_code": "KP31", "voice_key": "DIALOGUE1", "caption": "Ah! Seriously, don't scare me like that!"}, "110305": {"char_code": "KP31", "voice_key": "DIALOGUE2", "caption": "Commander, are you tired? Would you like me to put on some music?"}, "110306": {"char_code": "KP31", "voice_key": "DIALOGUE3", "caption": "It's not that I dislike you, Commander, I'm...just not that used to being so close to you..."}, "110307": {"char_code": "KP31", "voice_key": "MOOD1", "caption": "Ehehe~"}, "110308": {"char_code": "KP31", "voice_key": "ACCEPT", "caption": "Mhm."}, "110309": {"char_code": "KP31", "voice_key": "DIALOGUEWEDDING", "caption": "Commander, the concert from the other day was pretty good, wasn't it? I had a good time as well. Let's go again together some other time, just the two of us!"}, "110310": {"char_code": "KP31", "voice_key": "SOULCONTRACT", "caption": "Has this day finally come at last?<>Thank you for always being by my side, Commander. My mission is finally complete...<>Ah, Let me put on some music to celebrate!<>Eh? No need?"}, "110311": {"char_code": "KP31", "voice_key": "MOOD2", "caption": "...Wow!"}, "110312": {"char_code": "KP31", "voice_key": "HELLO", "caption": "Hello, Commander. I've cleaned your room. You can start your work whenever."}}}