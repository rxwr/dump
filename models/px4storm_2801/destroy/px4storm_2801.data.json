tion_name": "motions/touch_2.mtn", "touch_area": "head", "probability": 1.0, "voice": "GUN|Px4Storm|CHRISTMAS", "delay": 0, "is_hurt": 1}, "280126": {"id": 280126, "motion_name": "motions/shake.mtn", "touch_area": "0", "probability": 1.0, "voice": "", "delay": 0, "is_hurt": 1}, "280127": {"id": 280127, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|Px4Storm|HELLO", "delay": 0, "is_hurt": 1}}, "voiceData": {"280113": {"char_code": "", "voice_key": "", "caption": ""}, "280116": {"char_code": "Px4Storm", "voice_key": "FIX", "caption": "Good grief... I'll need to find an excuse to deceive the insurance company."}, "280117": {"char_code": "Px4Storm", "voice_key": "BREAK", "caption": "I can't believe I messed up like this!"}, "280118": {"char_code": "Px4Storm", "voice_key": "SKILL2", "caption": "To think I'd encounter them here...! I've got no choice!"}, "280119": {"char_code": "Px4Storm", "voice_key": "RETREAT", "caption": "Since I've been exposed, choosing to fight some other day is hardly shameful."}, "280120": {"char_code": "Px4Storm", "voice_key": "PHRASE", "caption": "How much is this worth?"}, "280121": {"char_code": "Px4Storm", "voice_key": "DIALOGUE3", "caption": "What? There's nothing that I want to buy, but don't you feel a sense of achievement when you watch your bank balance grow?"}, "280122": {"char_code": "Px4Storm", "voice_key": "DIALOGUE2", "caption": "Griffin work aside, I'd be glad to take on any odd jobs you have for me, Mastermind."}, "280123": {"char_code": "Px4Storm", "voice_key": "DIALOGUE1", "caption": "If the company was more generous with its bonus plan, then I'm sure everyone would be more motivated. Wouldn't you agree, Mastermind?"}, "280124": {"char_code": "Px4Storm", "voice_key": "WIN", "caption": "High-risk work that pays well. I expected nothing less of Griffin."}, "280125": {"char_code": "Px4Storm", "voice_key": "CHRISTMAS", "caption": "Not only do I believe in Santa Claus, I also respect him deeply. Why? It's because there's nowhere in this world that he can't enter!"}, "280126": {"char_code": "", "voice_key": "", "caption": ""}, "280127": {"char_code": "Px4Storm", "voice_key": "HELLO", "caption": "Did you come up with any new ideas, Mastermind? I mean, Commander?"}}}