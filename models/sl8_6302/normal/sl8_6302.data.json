12": {"id": 630212, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|SL8|HELLO", "delay": 3000, "is_hurt": 0}}, "voiceData": {"630201": {"char_code": "", "voice_key": "", "caption": ""}, "630202": {"char_code": "", "voice_key": "", "caption": ""}, "630203": {"char_code": "", "voice_key": "", "caption": ""}, "630204": {"char_code": "SL8", "voice_key": "DIALOGUE1", "caption": "The old toy? I got bored with it and chucked it. More importantly, Commander, what new stuff have you got? Show me and let's study it together?"}, "630205": {"char_code": "SL8", "voice_key": "TIP", "caption": "Unspoken rules are part of the game, too."}, "630206": {"char_code": "SL8", "voice_key": "BUILDOVER", "caption": "A newbie's here? Let's go see them together!"}, "630207": {"char_code": "SL8", "voice_key": "DIALOGUE2", "caption": "It's okay to be nostalgic, but not everyone has to feel that way, right? Some people look into the past, then someone must look into the future. Which are you, Commander?"}, "630208": {"char_code": "SL8", "voice_key": "OPERATIONBEGIN", "caption": "Hehe, what new things will I find this time?"}, "630209": {"char_code": "SL8", "voice_key": "DIALOGUEWEDDING", "caption": "Commander, I've been very interested in swimming lately... Wanna go together? What, my body isn't very waterproof? Then I'll just play outside the water!"}, "630210": {"char_code": "SL8", "voice_key": "SOULCONTRACT", "caption": "Got something cool to show me, Commander? <>An oath? Oh, sure! In return, please keep this certificate I ordered. <>An oath is meant to be exchanged, right?"}, "630211": {"char_code": "", "voice_key": "", "caption": ""}, "630212": {"char_code": "SL8", "voice_key": "HELLO", "caption": "You finally made it back. I've been waiting for a while."}}}