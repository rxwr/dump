0, "voice": "GUN|OTs14|SOULCONTRACT", "delay": 0, "is_hurt": 0}, "560212": {"id": 560212, "motion_name": "motions/shake.mtn", "touch_area": "0", "probability": 1.0, "voice": "", "delay": 0, "is_hurt": 0}, "560213": {"id": 560213, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|OTs14|HELLO", "delay": 1330, "is_hurt": 0}}, "voiceData": {"560201": {"char_code": "", "voice_key": "", "caption": ""}, "560202": {"char_code": "", "voice_key": "", "caption": ""}, "560203": {"char_code": "OTs14", "voice_key": "BREAK", "caption": "I'm in terrible shape. As I thought, it's all because I didn't adjust myself properly last night..."}, "560204": {"char_code": "OTs14", "voice_key": "TANABATA", "caption": "Let me help with the event tonight. Remember to treat me to a drink later."}, "560205": {"char_code": "OTs14", "voice_key": "DIALOGUE3", "caption": "What a nice atmosphere. Shall we play some fitting music to go alongside it?"}, "560206": {"char_code": "OTs14", "voice_key": "MOOD1", "caption": ""}, "560207": {"char_code": "OTs14", "voice_key": "ALLHALLOWS", "caption": "How about a dance with me tonight? Oh, your face is getting red."}, "560208": {"char_code": "OTs14", "voice_key": "RETREAT", "caption": "Perhaps...we ought to rest a little and then have something to drink, in order to keep our heads clear."}, "560209": {"char_code": "OTs14", "voice_key": "VALENTINE", "caption": "A bottle of wine on this rare occasion? Oh? Could you already have arrangements made? Hehe..."}, "560210": {"char_code": "OTs14", "voice_key": "DIALOGUEWEDDING", "caption": "What do you want to eat tonight? How does letting me cook again tonight sound? It's no trouble at all, and we did have fun the past several times."}, "560211": {"char_code": "OTs14", "voice_key": "SOULCONTRACT", "caption": "This is...for me? I already knew that this would happen.<>All of what you've suffered and endured so far, I've seen it with my own two eyes.<>Commander, you are the one that I have deemed to be worthy of my trust and belief, so let us stay side-by-side together forever."}, "560212": {"char_code": "", "voice_key": "", "caption": ""}, "560213": {"char_code": "OTs14", "voice_key": "HELLO", "caption": "Come, don't be so stiff, start by helping me make a cup of tea."}}}