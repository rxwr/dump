, "230112": {"id": 230112, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|NTW20|HELLO", "delay": 0, "is_hurt": 0}}, "voiceData": {"230101": {"char_code": "", "voice_key": "", "caption": ""}, "230102": {"char_code": "", "voice_key": "", "caption": ""}, "230103": {"char_code": "", "voice_key": "", "caption": ""}, "230104": {"char_code": "NTW20", "voice_key": "DIALOGUE3", "caption": "Just leave the sniping missions to me. Even if it's a cheetah sprinting in the prairie, I'll tag it in one shot."}, "230105": {"char_code": "NTW20", "voice_key": "SKILL1", "caption": "Taking aim...fire!"}, "230106": {"char_code": "NTW20", "voice_key": "DIALOGUE2", "caption": "Who's there? ....Oh, it's just you, Commander. If you so much as touch me, you'll get hurt."}, "230107": {"char_code": "NTW20", "voice_key": "DIALOGUE1", "caption": "Could you not stand behind me?"}, "230108": {"char_code": "NTW20", "voice_key": "SKILL3", "caption": "You think you can take me on? How imprudent."}, "230109": {"char_code": "NTW20", "voice_key": "DIALOGUEWEDDING", "caption": "Commander, let's go hunting again on our next vacation! Don't worry, I'll give you a head start, hehe!"}, "230110": {"char_code": "NTW20", "voice_key": "SOULCONTRACT", "caption": "I've always obtained my strength from you ever since the beginning, and I've always kept that thought close to my heart.<>Now, I've finally found a chance to repay you. Thank you, Commander."}, "230111": {"char_code": "", "voice_key": "", "caption": ""}, "230112": {"char_code": "NTW20", "voice_key": "HELLO", "caption": "Are you back at last? I've been waiting a long time for you, Commander."}}}