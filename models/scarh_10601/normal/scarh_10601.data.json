{"entry": {"id": 229, "code": "SCARH_10601", "directory": "scarh_10601", "motions": [1060101, 1060102, 1060103, 1060104, 1060105, 1060106, 1060107, 1060108, 1060109, 1060110, 1060111, 1060112, 1060113, 1060114, 1060115, 1060116, 1060117, 1060118, 1060119, 1060120]}, "variant": "normal", "motionData": {"1060101": {"id": 1060101, "motion_name": "daiji_idle_01.mtn", "touch_area": "", "probability": 1.0, "voice": "", "delay": 0, "is_hurt": 0}, "1060102": {"id": 1060102, "motion_name": "wait_1.mtn", "touch_area": "", "probability": 0.5, "voice": "", "delay": 0, "is_hurt": 0}, "1060103": {"id": 1060103, "motion_name": "wait_2.mtn", "touch_area": "", "probability": 0.5, "voice": "", "delay": 0, "is_hurt": 0}, "1060104": {"id": 1060104, "motion_name": "touch_1.mtn", "touch_area": "head", "probability": 1.0, "voice": "GUN|SCARH|FORMATION", "delay": 0, "is_hurt": 0}, "1060105": {"id": 1060105, "motion_name": "touch_2.mtn", "touch_area": "dog", "probability": 1.0, "voice": "GUN|SCARH|COMBINE", "delay": 1000, "is_hurt": 0}, "1060106": {"id": 1060106, "motion_name": "touch_3.mtn", "touch_area": "body", "probability": 1.0, "voice": "GUN|SCARH|BLACKACTION", "delay": 0, "is_hurt": 0}, "1060107": {"id": 1060107, "motion_name": "touch_4.mtn", "touch_area": "head", "probability": 1.0, "voice": "GUN|SCARH|PHRASE", "delay": 0, "is_hurt": 0}, "1060108": {"id": 1060108, "motion_name": "touch_5.mtn", "touch_area": "dog", "probability": 1.0, "voice": "GUN|SCARH|ATTACK", "delay": 0, "is_hurt": 0}, "1060109": {"id": 1060109, "motion_name": "wedding_touch.mtn", "touch_area": "leg", "probability": 1.0, "voice": "GUN|SCARH|DIALOGUEWEDDING", "delay": 0, "is_hurt": 0}, "1060110": {"id": 1060110, "motion_name": "login.mtn", "touch_area": "", "probability": 1.0, "voice": "GUN|SCARH|HELLO", "delay": 3200, "is_hurt": 0}, "1060111": {"id": 1060111, "motion_name": "shake.mtn", "touch_area": "", "probability": 1.0, "voice": "GUN|SCARH|LOWMOOD", "delay": 0, "is_hurt": 0}, "1060112": {"id": 1060112, "motion_name": "wedding.mtn", "touch_area": "", "probability": 1.0, "voice": "GUN|SCARH|SOULCONTRACT", "delay": 0, "is_hurt": 0}}, "voiceData": {"1060101": {"char_code": "", "voice_key": "", "caption": ""}, "1060102": {"char_code": "", "voice_key": "", "caption": ""}, "1060103": {"char_code": "", "voice_key": "", "caption": ""}, "1060104": {"char_code": "SCARH", "voice_key": "FORMATION", "caption": "I hope everyone here is reliable so that my laziness won't stand out."}, "1060105": {"char_code": "SCARH", "voice_key": "COMBINE", "caption": "Nice, another one to share the workload with."}, "1060106": {"char_code": "SCARH", "voice_key": "BLACKACTION", "caption": "Isn't this just following prior experiences and beating the enemy up again? Piece of cake."}, "1060107": {"char_code": "SCARH", "voice_key": "PHRASE", "caption": "Ah? Have I ever said that?"}, "1060108": {"char_code": "SCARH", "voice_key": "ATTACK", "caption": "It's the perfect time to attack!"}, "1060109": {"char_code": "SCARH", "voice_key": "DIALOGUEWEDDING", "caption": "All my friends have passed on, and all my enemies have perished. I thought I couldn't care less, thought that I wasn't afraid of being alone, and thought I always managed to keep it under wraps. Alas, Commander, please grant me this tiny request. Let me just... lean on you a little, just for a moment."}, "1060110": {"char_code": "SCARH", "voice_key": "HELLO", "caption": "Today and yesterday are much the same, just like the New World and the Old World."}, "1060111": {"char_code": "SCARH", "voice_key": "LOWMOOD", "caption": ""}, "1060112": {"char_code": "SCARH", "voice_key": "SOULCONTRACT", "caption": "Holding someone else's memory is a heavy burden; it's like being a thief stealing happiness that never belonged to you. <>Now, you and I can safeguard this secret together, since we're accomplices after all."}}}