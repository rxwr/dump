{"entry": {"id": 221, "code": "QBZ191_10101", "directory": "qbz191_10101", "motions": [1010101, 1010102, 1010103, 1010104, 1010105, 1010106, 1010107, 1010108, 1010109, 1010110, 1010111, 1010112, 1010113, 1010114, 1010115, 1010116, 1010117, 1010118, 1010119, 1010120]}, "variant": "normal", "motionData": {"1010101": {"id": 1010101, "motion_name": "motions/daiji_idle_01.mtn", "touch_area": "0", "probability": 1.0, "voice": "", "delay": 0, "is_hurt": 0}, "1010102": {"id": 1010102, "motion_name": "motions/wait_1.mtn", "touch_area": "0", "probability": 0.5, "voice": "", "delay": 0, "is_hurt": 0}, "1010103": {"id": 1010103, "motion_name": "motions/wait_2.mtn", "touch_area": "0", "probability": 0.5, "voice": "", "delay": 0, "is_hurt": 0}, "1010104": {"id": 1010104, "motion_name": "motions/touch_1.mtn", "touch_area": "head", "probability": 1.0, "voice": "GUN|QBZ191|NEWYEAR", "delay": 4000, "is_hurt": 0}, "1010105": {"id": 1010105, "motion_name": "motions/touch_2.mtn", "touch_area": "head", "probability": 1.0, "voice": "GUN|QBZ191|OPERATIONBEGIN", "delay": 0, "is_hurt": 0}, "1010106": {"id": 1010106, "motion_name": "motions/touch_3.mtn", "touch_area": "leg", "probability": 1.0, "voice": "GUN|QBZ191|DIALOGUE2", "delay": 0, "is_hurt": 0}, "1010107": {"id": 1010107, "motion_name": "motions/touch_4.mtn", "touch_area": "body", "probability": 1.0, "voice": "GUN|QBZ191|LOADING", "delay": 1000, "is_hurt": 0}, "1010108": {"id": 1010108, "motion_name": "motions/touch_5.mtn", "touch_area": "leg", "probability": 1.0, "voice": "GUN|QBZ191|FIX", "delay": 6000, "is_hurt": 0}, "1010109": {"id": 1010109, "motion_name": "motions/wedding_touch.mtn", "touch_area": "body", "probability": 1.0, "voice": "GUN|QBZ191|DIALOGUEWEDDING", "delay": 0, "is_hurt": 0}, "1010110": {"id": 1010110, "motion_name": "motions/wedding.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|QBZ191|SOULCONTRACT", "delay": 0, "is_hurt": 0}, "1010111": {"id": 1010111, "motion_name": "motions/shake.mtn", "touch_area": "0", "probability": 1.0, "voice": "", "delay": 0, "is_hurt": 0}, "1010112": {"id": 1010112, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|QBZ191|HELLO", "delay": 1000, "is_hurt": 0}}, "voiceData": {"1010101": {"char_code": "", "voice_key": "", "caption": ""}, "1010102": {"char_code": "", "voice_key": "", "caption": ""}, "1010103": {"char_code": "", "voice_key": "", "caption": ""}, "1010104": {"char_code": "QBZ191", "voice_key": "NEWYEAR", "caption": "Happy new year, Commander, and happy new year to you too, girls... What? You want me to play the Nian? Because I've got sockets for horns on my head? Heck no!"}, "1010105": {"char_code": "QBZ191", "voice_key": "OPERATIONBEGIN", "caption": "One must prepare many things for a long journey, like instant food, a field cooking kit, backup signal beacons..."}, "1010106": {"char_code": "QBZ191", "voice_key": "DIALOGUE2", "caption": "Please take your wicked hands off me! These are not bunny ears or kangaroo ears and they are certainly not draconian horns! They are simply my custom-made signal beacons."}, "1010107": {"char_code": "QBZ191", "voice_key": "LOADING", "caption": "Let's relax while we're waiting!"}, "1010108": {"char_code": "QBZ191", "voice_key": "FIX", "caption": "Don't worry, this is just like a massage for me."}, "1010109": {"char_code": "QBZ191", "voice_key": "DIALOGUEWEDDING", "caption": "You keep saying you don't mind not knowing about me, but the truth is, you're really curious about it, aren't you? In that case, I'll give you a little hint: \"A stitch in time...\""}, "1010110": {"char_code": "QBZ191", "voice_key": "SOULCONTRACT", "caption": "I thought that the destiny of a Doll like myself was to wander from place to place until I faded away one day... <> I didn't expect that I would be staying here for such a special reason. <> Thank you for giving me a place where I can rest at ease, Commander."}, "1010111": {"char_code": "", "voice_key": "", "caption": ""}, "1010112": {"char_code": "QBZ191", "voice_key": "HELLO", "caption": "You're here, Commander. Now measuring today's mood index... Just kidding, I don't have such a function."}}}