: {"id": 790212, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|A545|HELLO", "delay": 0, "is_hurt": 0}}, "voiceData": {"790201": {"char_code": "", "voice_key": "", "caption": ""}, "790202": {"char_code": "", "voice_key": "", "caption": ""}, "790203": {"char_code": "", "voice_key": "", "caption": ""}, "790204": {"char_code": "A545", "voice_key": "DIALOGUE3", "caption": "This is the strongest liquor you have? I thought it was just water in some fancy packaging... There's no way this can tide us over a whole day of club activities."}, "790205": {"char_code": "A545", "voice_key": "NEWYEAR", "caption": "Just this once, let's bring out all the stockpile of the Vodka Club, so that everyone can drink to their heart's content!"}, "790206": {"char_code": "A545", "voice_key": "FEED", "caption": "Only the truly powerful has what it takes to join my perfect team...so don't forget my club members."}, "790207": {"char_code": "A545", "voice_key": "LOADING", "caption": "I don't have enough booze with me to kill all this time."}, "790208": {"char_code": "A545", "voice_key": "BUILDOVER", "caption": "The Vodka Club has increased in size again. Let's test out how the new members carry their alcohol first."}, "790209": {"char_code": "A545", "voice_key": "DIALOGUEWEDDING", "caption": "We don't need watery drinks at home⁠—you should've known. So now I'm confiscating all this booze with low alcohol content."}, "790210": {"char_code": "A545", "voice_key": "SOULCONTRACT", "caption": "No wonder you've become such a good drinker lately, so you have an ulterior motive...<> Still, I understand that this is a show of sincerity.<> It'll be nice to have a good drinking partner who appreciates a lovely drink from now on. It's decided then."}, "790211": {"char_code": "", "voice_key": "", "caption": ""}, "790212": {"char_code": "A545", "voice_key": "HELLO", "caption": "All on-duty personnel is lined up. We can now get on with our work."}}}