t": 0}, "860112": {"id": 860112, "motion_name": "motions/shake.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|DP12|LOWMOOD", "delay": 0, "is_hurt": 0}, "860113": {"id": 860113, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|DP12|HELLO", "delay": 2100, "is_hurt": 0}}, "voiceData": {"860101": {"char_code": "", "voice_key": "", "caption": ""}, "860102": {"char_code": "", "voice_key": "", "caption": ""}, "860103": {"char_code": "DP12", "voice_key": "DIALOGUE1", "caption": "Are you interested in folklore? Every place has a different culture and different legends. Studying how the same legend has changed as it spread to different places is like tracing a human's veins to the heart... What do you think?"}, "860104": {"char_code": "DP12", "voice_key": "TIP", "caption": "These little things can make your job go much more smoothly."}, "860105": {"char_code": "DP12", "voice_key": "LOADING", "caption": "A good job needs ample preparation. Wait a moment, please."}, "860106": {"char_code": "DP12", "voice_key": "BLACKACTION", "caption": "Leave it to us. We'll give you a satisfactory outcome."}, "860107": {"char_code": "DP12", "voice_key": "GOATTACK", "caption": "We're heading out. I'll try to make the combat report more exciting."}, "860108": {"char_code": "", "voice_key": "", "caption": ""}, "860109": {"char_code": "", "voice_key": "", "caption": ""}, "860110": {"char_code": "DP12", "voice_key": "DIALOGUEWEDDING", "caption": "I don't want to stop reading or writing here at Griffin. Even though we'll leave the world behind one day, legends are eternal... I mean, would you like to be the protagonist in my novel?"}, "860111": {"char_code": "DP12", "voice_key": "SOULCONTRACT", "caption": "Gotcha, Commander. Now where's my reward? <>...I didn't expect it to be this. I thought it'd take you longer to give it to me... Still, I'm not giving it back. <>Then let's stay together and witness how all stories end..."}, "860112": {"char_code": "DP12", "voice_key": "LOWMOOD", "caption": ""}, "860113": {"char_code": "DP12", "voice_key": "HELLO", "caption": "As always, you showed up at work on time."}}}