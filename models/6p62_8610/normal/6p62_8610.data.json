delay": 0, "is_hurt": 0}, "861012": {"id": 861012, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|6P62|HELLO", "delay": 3100, "is_hurt": 0}}, "voiceData": {"861001": {"char_code": "", "voice_key": "", "caption": ""}, "861002": {"char_code": "", "voice_key": "", "caption": ""}, "861003": {"char_code": "", "voice_key": "", "caption": ""}, "861004": {"char_code": "6P62", "voice_key": "FIX", "caption": "Come on, don't be shy, treat this place like your own home!"}, "861005": {"char_code": "6P62", "voice_key": "LOADING", "caption": "I'm preparing now, give me a bit."}, "861006": {"char_code": "6P62", "voice_key": "DIALOGUE3", "caption": "Commander, please refrain from touching the balancer on my back. I'll fall over! ...N-Not the front either!"}, "861007": {"char_code": "6P62", "voice_key": "DIALOGUE1", "caption": "Are you sortieing, Commander? I'm always ready to go."}, "861008": {"char_code": "6P62", "voice_key": "OPERATIONBEGIN", "caption": "You can leave the important operations to me."}, "861009": {"char_code": "6P62", "voice_key": "DIALOGUEWEDDING", "caption": "Commander, we've completed more than the required amount of work again today! It's good to take a break. That's what you've taught me before."}, "861010": {"char_code": "6P62", "voice_key": "SOULCONTRACT", "caption": "Eh? Commander...is this for me?<>Ah... you didn't trade for it with the resources that I've saved for you, right?<>Haha, just joking. Commander, thank you for never giving up on me and giving me a place where I can finally be useful...<>Please let me repay for your guidance with my utmost sincerity."}, "861011": {"char_code": "", "voice_key": "", "caption": ""}, "861012": {"char_code": "6P62", "voice_key": "HELLO", "caption": "Commander, let's work hard today for victory too."}}}