{"entry": {"id": 123, "code": "ZB26_4703", "directory": "zb26_4703", "motions": [470301, 470302, 470303, 470304, 470305, 470306, 470307, 470308, 470309, 470310, 470311, 470312, 470313, 470314, 470315, 470316, 470317, 470318, 470319]}, "variant": "normal", "motionData": {"470301": {"id": 470301, "motion_name": "motions/daiji_idle_01.mtn", "touch_area": "0", "probability": 1.0, "voice": "", "delay": 0, "is_hurt": 0}, "470302": {"id": 470302, "motion_name": "motions/wait_1.mtn", "touch_area": "0", "probability": 0.5, "voice": "", "delay": 0, "is_hurt": 0}, "470303": {"id": 470303, "motion_name": "motions/touch_01.mtn", "touch_area": "head", "probability": 1.0, "voice": "GUN|ZB26|DIALOGUE1", "delay": 0, "is_hurt": 0}, "470304": {"id": 470304, "motion_name": "motions/touch_02.mtn", "touch_area": "head", "probability": 1.0, "voice": "GUN|ZB26|GAIN", "delay": 0, "is_hurt": 0}, "470305": {"id": 470305, "motion_name": "motions/touch_03.mtn", "touch_area": "body", "probability": 1.0, "voice": "GUN|ZB26|DIALOGUE2", "delay": 0, "is_hurt": 0}, "470306": {"id": 470306, "motion_name": "motions/touch_04.mtn", "touch_area": "body", "probability": 1.0, "voice": "GUN|ZB26|BUILDOVER", "delay": 0, "is_hurt": 0}, "470307": {"id": 470307, "motion_name": "motions/touch_05.mtn", "touch_area": "leg", "probability": 1.0, "voice": "GUN|ZB26|OPERATIONOVER", "delay": 0, "is_hurt": 0}, "470308": {"id": 470308, "motion_name": "motions/wedding_touch.mtn", "touch_area": "body", "probability": 1.0, "voice": "GUN|ZB26|DIALOGUEWEDDING", "delay": 0, "is_hurt": 0}, "470309": {"id": 470309, "motion_name": "motions/wedding.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|ZB26|SOULCONTRACT", "delay": 0, "is_hurt": 0}, "470310": {"id": 470310, "motion_name": "motions/shake.mtn", "touch_area": "0", "probability": 1.0, "voice": "", "delay": 0, "is_hurt": 0}, "470311": {"id": 470311, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|ZB26|HELLO", "delay": 0, "is_hurt": 0}}, "voiceData": {"470301": {"char_code": "", "voice_key": "", "caption": ""}, "470302": {"char_code": "", "voice_key": "", "caption": ""}, "470303": {"char_code": "ZB26", "voice_key": "DIALOGUE1", "caption": "Do you know, Commander? One should always take the initiative to interact with others... That's why I've come and sought you out."}, "470304": {"char_code": "ZB26", "voice_key": "GAIN", "caption": "So this is Griffin? ...I see. Please look forward to my performance. I will do my best no matter where I am."}, "470305": {"char_code": "ZB26", "voice_key": "DIALOGUE2", "caption": "I often think...Dolls are so close to humans, but why do the majority of humans refuse to understand us?"}, "470306": {"char_code": "ZB26", "voice_key": "BUILDOVER", "caption": "The rookies are here. Why don't you come with me and have a look? One can only grow by interacting with all sorts of people."}, "470307": {"char_code": "ZB26", "voice_key": "OPERATIONOVER", "caption": "Well? Are you happy with the result?"}, "470308": {"char_code": "ZB26", "voice_key": "DIALOGUEWEDDING", "caption": "Even though I often say one mustn't give up halfway, your working hours are way too long... I am putting you on mandatory break for a while. Don't worry, I'll keep you company."}, "470309": {"char_code": "ZB26", "voice_key": "SOULCONTRACT", "caption": "Have you really considered this carefully? Once you've entered a contract with me... <>I won't let go of you no matter where you are… <>I will always, always be by your side."}, "470310": {"char_code": "", "voice_key": "", "caption": ""}, "470311": {"char_code": "ZB26", "voice_key": "HELLO", "caption": "Welcome back, I've already sorted the documents you have to look through."}}}