 "370112": {"id": 370112, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|PA15|HELLO", "delay": 0, "is_hurt": 0}}, "voiceData": {"370101": {"char_code": "", "voice_key": "", "caption": ""}, "370102": {"char_code": "", "voice_key": "", "caption": ""}, "370103": {"char_code": "", "voice_key": "", "caption": ""}, "370104": {"char_code": "PA15", "voice_key": "DIALOGUE1", "caption": "You didn't look like the sort to have this kind of hobby, Commander. Although it's not a bad thing to be so straightforward about seeking excitement."}, "370105": {"char_code": "PA15", "voice_key": "PHRASE", "caption": "Yo, what's so interesting?"}, "370106": {"char_code": "PA15", "voice_key": "DIALOGUE2", "caption": "Wow! You surprised with me that move. Awesome!"}, "370107": {"char_code": "PA15", "voice_key": "OPERATIONBEGIN", "caption": "Then I'm heading off to play! Just kidding. Salut, Commander."}, "370108": {"char_code": "PA15", "voice_key": "DIALOGUE3", "caption": "Do any Griffin Dolls get their fill of satisfaction from being broken? I'd like to give that a try."}, "370109": {"char_code": "PA15", "voice_key": "DIALOGUEWEDDING", "caption": "Thanks for the hard work today. Want to have some fun at a night themed amusement park after work? Or do you want to quietly relax with a drink somewhere?"}, "370110": {"char_code": "PA15", "voice_key": "SOULCONTRACT", "caption": "Ah, Commander, you're here.<>Huhu, are you here to swear an oath with me?<>What's with that expression? I can tell your thoughts with just one look.<>Then, shall we?"}, "370111": {"char_code": "", "voice_key": "", "caption": ""}, "370112": {"char_code": "PA15", "voice_key": "HELLO", "caption": "Ahhhh, here it comes, here it comes! Something interesting is happening!"}}}