, "is_hurt": 0}, "300112": {"id": 300112, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|OTs14|HELLO", "delay": 0, "is_hurt": 0}}, "voiceData": {"300101": {"char_code": "", "voice_key": "", "caption": ""}, "300102": {"char_code": "", "voice_key": "", "caption": ""}, "300103": {"char_code": "", "voice_key": "", "caption": ""}, "300104": {"char_code": "OTs14", "voice_key": "DIALOGUE1", "caption": "What do you have planned today? Let's hear it."}, "300105": {"char_code": "OTs14", "voice_key": "DIALOGUE2", "caption": "Let me guess... Judging from your expression, you're not here to talk about work."}, "300106": {"char_code": "OTs14", "voice_key": "DIALOGUE3", "caption": "What a nice atmosphere. Shall we play some fitting music to go alongside it?"}, "300107": {"char_code": "OTs14", "voice_key": "MOOD1", "caption": ""}, "300108": {"char_code": "OTs14", "voice_key": "NEWYEAR", "caption": "Happy New Year. I hope things will remain this way for the upcoming year, so I have something to look forward to."}, "300109": {"char_code": "OTs14", "voice_key": "DIALOGUEWEDDING", "caption": "What do you want to eat tonight? How does letting me cook again tonight sound? It's no trouble at all, and we did have fun the past several times."}, "300110": {"char_code": "OTs14", "voice_key": "SOULCONTRACT", "caption": "This is...for me? I already knew that this would happen.<>All of what you've suffered and endured so far, I've seen it with my own two eyes.<>Commander, you are the one that I have deemed to be worthy of my trust and belief, so let us stay side-by-side together forever."}, "300111": {"char_code": "OTs14", "voice_key": "MOOD2", "caption": "Huh!?"}, "300112": {"char_code": "OTs14", "voice_key": "HELLO", "caption": "Come, don't be so stiff, start by helping me make a cup of tea."}}}