0}, "870112": {"id": 870112, "motion_name": "motions/LOADING.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|PA15|LOADING", "delay": 2000, "is_hurt": 0}}, "voiceData": {"870101": {"char_code": "", "voice_key": "", "caption": ""}, "870102": {"char_code": "", "voice_key": "", "caption": ""}, "870103": {"char_code": "", "voice_key": "", "caption": ""}, "870104": {"char_code": "PA15", "voice_key": "GAIN", "caption": "Hello, Commander! PA-15 reporting. You will assign me the most exciting missions, right?"}, "870105": {"char_code": "PA15", "voice_key": "DIALOGUE1", "caption": "You didn't look like the sort to have this kind of hobby, Commander. Although it's not a bad thing to be so straightforward about seeking excitement."}, "870106": {"char_code": "PA15", "voice_key": "PHRASE", "caption": "Yo, what's so interesting?"}, "870107": {"char_code": "PA15", "voice_key": "BUILDOVER", "caption": "Oooh, a cutie I can play with?"}, "870108": {"char_code": "PA15", "voice_key": "TIP", "caption": "I've got a new idea, want to give it a try?"}, "870109": {"char_code": "PA15", "voice_key": "DIALOGUEWEDDING", "caption": "Thanks for the hard work today. Want to have some fun at a night themed amusement park after work? Or do you want to quietly relax with a drink somewhere?"}, "870110": {"char_code": "PA15", "voice_key": "SOULCONTRACT", "caption": "Ah, Commander, you're here.<>Huhu, are you here to swear an oath with me?<>What's with that expression? I can tell your thoughts with just one look.<>Then, shall we?"}, "870111": {"char_code": "", "voice_key": "", "caption": ""}, "870112": {"char_code": "PA15", "voice_key": "LOADING", "caption": "I wonder what sort of adventures will be waiting for me today? I can't wait~"}}}