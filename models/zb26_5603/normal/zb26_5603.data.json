312": {"id": 560312, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|ZB26|HELLO", "delay": 6000, "is_hurt": 0}}, "voiceData": {"560301": {"char_code": "", "voice_key": "", "caption": ""}, "560302": {"char_code": "", "voice_key": "", "caption": ""}, "560303": {"char_code": "", "voice_key": "", "caption": ""}, "560304": {"char_code": "ZB26", "voice_key": "VALENTINE", "caption": "I made chocolate for you. Each piece has the same size, shape and calorie content."}, "560305": {"char_code": "ZB26", "voice_key": "DIALOGUE1", "caption": "Do you know, Commander? One should always take the initiative to interact with others... That's why I've come and sought you out."}, "560306": {"char_code": "ZB26", "voice_key": "DIALOGUE3", "caption": "The objects aren't placed properly on your desk. That's alright, I'll tidy it for you... What? You won't be able to find your things? That...that won't happen."}, "560307": {"char_code": "ZB26", "voice_key": "WIN", "caption": "Victory in battle is merely the first step towards peace... Neither you nor I can relax."}, "560308": {"char_code": "ZB26", "voice_key": "FORMATION", "caption": "You can put me anywhere you want. I will fight for you with all my strength."}, "560309": {"char_code": "ZB26", "voice_key": "DIALOGUEWEDDING", "caption": "Even though I often say one mustn't give up halfway, your working hours are way too long... I am putting you on mandatory break for a while. Don't worry, I'll keep you company."}, "560310": {"char_code": "ZB26", "voice_key": "SOULCONTRACT", "caption": "Have you really considered this carefully? Once you've entered a contract with me... <>I won't let go of you no matter where you are… <>I will always, always be by your side."}, "560311": {"char_code": "", "voice_key": "", "caption": ""}, "560312": {"char_code": "ZB26", "voice_key": "HELLO", "caption": "Welcome back, I've already sorted the documents you have to look through."}}}