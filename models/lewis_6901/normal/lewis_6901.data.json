is_hurt": 0}, "690112": {"id": 690112, "motion_name": "motions/login.mtn", "touch_area": "0", "probability": 1.0, "voice": "GUN|Lewis|HELLO", "delay": 0, "is_hurt": 0}, "690121": {"id": 690121, "motion_name": "motions/repeat.mtn", "touch_area": "0", "probability": 1.0, "voice": "", "delay": 0, "is_hurt": 0}}, "voiceData": {"690101": {"char_code": "", "voice_key": "", "caption": ""}, "690102": {"char_code": "", "voice_key": "", "caption": ""}, "690103": {"char_code": "", "voice_key": "", "caption": ""}, "690104": {"char_code": "Lewis", "voice_key": "DIALOGUE2", "caption": "Everyone looks so adorable, I can't believe they're all Tactical Dolls! Are you trying to deceive the enemy?"}, "690105": {"char_code": "Lewis", "voice_key": "DIALOGUE3", "caption": "Hm? You want to arm-wrestle with me, Commander? I'm very good at it, you know."}, "690106": {"char_code": "Lewis", "voice_key": "VALENTINE", "caption": "Rather than the taste, it's the wrapper that is the soul of chocolate. If it doesn't look good, then your chocolate won't taste good either."}, "690107": {"char_code": "Lewis", "voice_key": "COMBINE", "caption": "Heheh... I look so reliable~"}, "690108": {"char_code": "Lewis", "voice_key": "LOADING", "caption": "Commander, you look like you're in a good mood, did something good happen?"}, "690109": {"char_code": "Lewis", "voice_key": "DIALOGUEWEDDING", "caption": "No matter how tired or unhappy I am, I perk up right away when I see you, Commander! Hehe~"}, "690110": {"char_code": "Lewis", "voice_key": "SOULCONTRACT", "caption": "Commander, while you're the person I'm most familiar with, there are times when you seem like such a stranger... <>I can't bear to just gaze at you from afar, I want to enter your heart. <>I...I want to know everything about you."}, "690111": {"char_code": "", "voice_key": "", "caption": ""}, "690112": {"char_code": "Lewis", "voice_key": "HELLO", "caption": "Huh? Commander? ...Crap, almost forgot I've still got stuff to do!"}, "690121": {"char_code": "", "voice_key": "", "caption": ""}}}